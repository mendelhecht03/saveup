# Copy to mvp/.env.local. Keep real values out of Git and chat.
# Both values come from your Plaid Dashboard's Sandbox configuration.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# The server always binds to this computer only.
PORT=4188
# Optional: directory for SQLite and its local token-encryption key.
# Default on Windows: %LOCALAPPDATA%\SaveUp\sandbox-mvp
# SAVEUP_DATA_DIR=C:\dev\saveup-local-data
